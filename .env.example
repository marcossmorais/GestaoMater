APP_URL=http://localhost:8000

# Banco local (Docker). Para o Supabase, troque host/porta/usuário/senha e use DB_SSLMODE=require
DB_HOST=db
DB_PORT=5432
DB_NAME=mater
DB_USER=mater
DB_PASSWORD=mater
DB_SSLMODE=disable

# Clerk (https://dashboard.clerk.com -> API Keys). Vazio = login antigo por nome + código (só para dev)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
