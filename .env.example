APP_URL=http://localhost:8000

# Banco local (Docker). Para o Supabase, troque host/porta/usuário/senha e use DB_SSLMODE=require
DB_HOST=db
DB_PORT=5432
DB_NAME=mater
DB_USER=mater
DB_PASSWORD=mater
DB_SSLMODE=disable

# Clerk (https://dashboard.clerk.com -> API Keys). Vazio = login antigo por nome + código (só para dev)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (API). O app PHP usa só a conexão Postgres acima (DB_*); estas chaves ficam para integrações futuras
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Documentos (declarações/boletim). Chave da assinatura eletrônica: 32+ caracteres aleatórios, nunca versionar.
# Gerar: openssl rand -hex 32
APP_SIGNING_KEY=
SCHOOL_NAME=MATER Colégio e Curso
# Credenciamento/CNPJ e endereço impressos no cabeçalho (vazio = não imprime)
SCHOOL_LEGAL_INFO=
SCHOOL_ADDRESS=
SCHOOL_CITY=
