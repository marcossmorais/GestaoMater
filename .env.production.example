# Mater — produção (docker-compose.prod.yml). Copie para .env na VPS e preencha. Nunca versionar o .env.
# Campos sem valor padrão são obrigatórios: o docker compose se recusa a subir sem eles.

# Domínio do portal (o DNS precisa apontar para a VPS). O Caddy emite o certificado HTTPS sozinho.
APP_DOMAIN=portal.exemplo.com.br
APP_URL=https://portal.exemplo.com.br

# Banco (container db, rede interna). Senha forte: openssl rand -hex 24
DB_NAME=mater
DB_USER=mater
DB_PASSWORD=
DB_SSLMODE=disable

# Clerk de PRODUÇÃO (dashboard.clerk.com -> instância Production -> API Keys): pk_live_... / sk_live_...
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Assinatura dos documentos: openssl rand -hex 32. Trocar invalida todos os documentos já emitidos.
APP_SIGNING_KEY=

# Cabeçalho dos documentos oficiais: só dados reais da escola (vazio = não imprime)
SCHOOL_NAME=MATER Colégio e Curso
SCHOOL_LEGAL_INFO=
SCHOOL_ADDRESS=
SCHOOL_CITY=
