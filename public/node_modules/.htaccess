# Mater — só os arquivos que as telas usam ficam acessíveis; o resto da pasta (testes, fontes, pacotes sem uso,
# package.json com versões) responde 404. Ao usar arquivo novo de um pacote, acrescente o caminho abaixo.
<IfModule mod_rewrite.c>
	RewriteEngine on
	RewriteRule ^(bootstrap/dist/(css|js)/[^/]+\.(css|js|map)|jquery/dist/jquery\.min\.js|jquery-mask-plugin/dist/jquery\.mask\.min\.js|chart\.js/dist/chart\.umd\.js|@fortawesome/fontawesome-free/(css|webfonts)/[^/]+)$ - [L]
	RewriteRule ^ - [R=404,L]
</IfModule>
